# --- Telegram (API_ID / API_HASH from https://my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-from-BotFather
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ADMIN_IDS=123456789

# --- Your website admin (the bot logs in like your browser does) ---
# Folder that contains r2admin.php and r2_upload_api.php, no trailing file name
SITE_URL=https://yourdomain.com/Audiosfm
# The same PIN you type on the r2admin.php login page
ADMIN_PIN=

# --- Defaults (changeable from Telegram) ---
DEFAULT_COMPRESS=0
DEFAULT_BITRATE=64
DEFAULT_MONO=1
DEFAULT_NAME_PATTERN=Ep {n:03d}
